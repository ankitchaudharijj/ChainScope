# Copy this file to .env and fill in real values before running.

# PostgreSQL connection. When running via docker-compose, "db" is the
# service name below — leave it as-is. Running locally without Docker,
# point this at your own Postgres instance instead.
DATABASE_URL=postgresql://chainscope:chainscope@db:5432/chainscope

# Neo4j — the Graph Engine (architecture doc component 05). Used for
# multi-hop fund-flow tracing that would be awkward as recursive SQL.
# Leave as-is for docker-compose; point elsewhere for a standalone Neo4j.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chainscope123

# Blockchain Data Engine — live lookups for addresses not already cached.
# Bitcoin needs no key (Blockstream's public Esplora API). Ethereum needs
# a free API key: sign up at https://etherscan.io/apis, generate a key,
# paste it below. Leave blank and ETH addresses outside the seeded
# specimen set will return 404 instead of a live result.
ETHERSCAN_API_KEY=

# Secret used to sign JWT session tokens. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-character-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of origins allowed to call this API from a browser.
# "null" covers opening the frontend HTML file directly by double-click
# (file:// pages send Origin: null) — remove it before any real deployment.
CORS_ORIGINS=null,http://localhost:8080,http://localhost:5173,http://localhost:3000
